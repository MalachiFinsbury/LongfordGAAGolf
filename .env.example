# Supabase — from your project's Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (server-only, NEVER expose to the browser). Used by the admin dashboard to read submissions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Dashboard → Developers → API keys.
# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...): grant it only
# write access to Checkout Sessions, Customers, Invoices, Products and Prices.
# On Vercel, mark this as a Sensitive environment variable.
STRIPE_SECRET_KEY=sk_test_your-test-key

# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Locally: `npm run stripe:listen` prints one.
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret

# Optional. Absolute origin used for Stripe return URLs. Leave unset to derive
# it from the request, which keeps preview deployments self-contained.
# NEXT_PUBLIC_SITE_URL=https://longford-gaa-golf.vercel.app

# Hardcoded admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# --- Email (Resend) ---------------------------------------------------------
# Transactional email for registration confirmations and organiser alerts.
# Free tier (3,000/month, 100/day) comfortably covers this event.
# Create a key at resend.com → API Keys. On Vercel, mark it Sensitive.
RESEND_API_KEY=re_your-api-key

# The From header. Its domain must be verified in Resend (Domains → add the
# DKIM/SPF records) or nothing will deliver.
EMAIL_FROM="Longford GAA Golf Classic <noreply@longfordgaafundraising.com>"

# Who receives the "new registration" alerts. Comma-separated for several.
# Unset means payers still get their confirmation and organisers get nothing.
ORGANISER_EMAILS=organiser@example.com
