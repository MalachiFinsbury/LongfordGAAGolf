# Supabase — from your project's Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (server-only, NEVER expose to the browser). Used by the admin dashboard to read submissions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hardcoded admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string
